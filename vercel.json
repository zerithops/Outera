{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/places/:slug",
      "destination": "/place/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(admin.*|login|signup|forgot-password|reset-password|auth/.*|profile|saved|api/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/admin-users",
      "destination": "/api/admin-users"
    },
    {
      "source": "/api/navigation-route",
      "destination": "/api/navigation-route"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/post-share?slug=:slug"
    },
    {
      "source": "/place/:slug",
      "destination": "/api/place-share?slug=:slug"
    },
    {
      "source": "/places/:slug",
      "destination": "/api/place-share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

