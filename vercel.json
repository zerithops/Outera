{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/navigation-route",
      "destination": "/api/navigation-route"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/post-share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
