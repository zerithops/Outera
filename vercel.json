{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.outerabd.buzz"
        }
      ],
      "destination": "https://outerabd.buzz/:path*",
      "permanent": true
    },
    {
      "source": "/places/:slug",
      "destination": "/place/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=900, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(admin.*|dashboard.*|login|register|signup|forgot-password|reset-password|auth/.*|profile|saved|api/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/admin-users",
      "destination": "/api/admin-users"
    },
    {
      "source": "/api/navigation-route",
      "destination": "/api/navigation-route"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/post-share?slug=:slug"
    },
    {
      "source": "/place/:slug",
      "destination": "/api/place-share?slug=:slug"
    },
    {
      "source": "/places/:slug",
      "destination": "/api/place-share?slug=:slug"
    },
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|api/).*)",
      "destination": "/index.html"
    }
  ]
}
